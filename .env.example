# Copy to .env.local for local development with sync. Both values come from
# Supabase → Project Settings → API Keys / Data API. The publishable key is
# safe to expose; never put the secret (service_role) key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
