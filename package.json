{
  "name": "murajaah",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "data:fetch": "node scripts/fetch-tanzil.mjs",
    "data:build": "node scripts/build-data.mjs && node scripts/build-translations.mjs",
    "data:check": "node scripts/crosscheck-qurancom.mjs"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "fast-xml-parser": "^5.12.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "description": "Revise your Qur'an memorization by rub' and by ayah",
  "license": "MIT",
  "homepage": "https://noorul-ayn.github.io/murajaah-revision-/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noorul-Ayn/murajaah-revision-.git"
  },
  "bugs": {
    "url": "https://github.com/Noorul-Ayn/murajaah-revision-/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
